                            <diagram dimensions="(250,250)" margins="5">
                                <definition>f(x)=1/18*(x+2)*(x-3)*(x-5)*(x^2+2)</definition>
                                <coordinates bbox="[-2,-2,8,8]">
                                    <grid-axes spacings="((-4,1/2,16),(-4,1/2,16))" xlabel="x" ylabel="y" hticks="(-4,2,16)" vticks="(-4,2,16)"  
                                    decorations="yes"/>
