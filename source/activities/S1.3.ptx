                </p>

    <sidebyside widths="35% 35%">
                  <image>
                        <shortdescription>
                            A square grid between -2 and 8 to plot the function that meets the requirements (if possible).
                        </shortdescription>
                        <prefigure xmlns="https://prefigure.org" label="prefigure-1-3-5">
                            
