                <cell><m>2</m></cell>
              </row>
            </tabular>
          </stack>
          <image>
      <shortdescription>
        The graph of draw e^x and ln(x).
      </shortdescription>
      <prefigure xmlns="https://prefigure.org" label="prefigure-124-3-4-3soln">
        <diagram dimensions="(350,350)" margins="7">
          <definition>f(t)=e^t</definition>
          <definition>g(t)=ln(t)</definition>
          <definition>h(t) = t</definition>
          
          <coordinates bbox="(-8,-8,8,8)">
            <grid-axes decorations="yes"  xlabel="x" ylabel="y" spacings="((-8,1,8),(-8,1,8))"
            hlabels="(-7,1,7)" vlabels="(-7,1,7)"/>
            <graph function="f"/>
            <graph function="g" stroke="red"/>
            <graph function="h" dash="4 4"/>
  
