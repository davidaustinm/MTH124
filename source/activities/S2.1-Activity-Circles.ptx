<?xml version="1.0" encoding="UTF-8"?>
<handout>
<title>S2.1 Activity: Circles</title>
  <!--<paragraphs><title>S2.1-Activity-Circles</title></paragraphs>
-->
  <image>
    <shortdescription>A circle for the activity.</shortdescription>
    <prefigure xmlns="https://prefigure.org" label="prefigure-circle1">
                        <diagram dimensions="(200,200)" margins="5">
                          <definition>c=((4,5))</definition>
                          <definition>c1=4</definition>
                          <definition>c2=5</definition>
                          <definition>rad=12/pi</definition>
                          <definition>r=((c1+rad,c2))</definition>
                          <definition>l=((c1-rad,c2))</definition>
                          <definition>u=((c1,c2+rad))</definition>
                          <definition>d=((c1,c2-rad))</definition>
                            <coordinates bbox="[-1,-1,10,10]">
                                <grid-axes decorations="yes"/>
                                <circle center="(4,5)" radius="rad" />
                                <point p="c" ><m>(4,5)</m></point>
                                <point p="r"/>
                                <point p="l"/>
                                <point p="u"/>
                                <point p="d"/>
                                <label anchor="(1,9.)" alignment="ne">Circumference = 24</label>

                            </coordinates>
                        </diagram>
                    </prefigure>
  </image>

<image>
    <shortdescription>A circle for the activity.</shortdescription>
    <prefigure xmlns="https://prefigure.org" label="prefigure-circle2">
                        <diagram dimensions="(200,200)" margins="5">
                          
                          <definition>c1=1</definition>
                          <definition>c2=3</definition>
                          <definition>c=((c1,c2))</definition>
                          <definition>rad=6/pi</definition>
                          <definition>r=((c1+rad,c2))</definition>
                          <definition>l=((c1-rad,c2))</definition>
                          <definition>u=((c1,c2+rad))</definition>
                          <definition>d=((c1,c2-rad))</definition>
                            <coordinates bbox="[-2,-1,5,6]">
                                <grid-axes decorations="yes"/>
                                <circle center="c" radius="rad" />
                                <point p="c" ><m>(1,3)</m></point>
                                <point p="r"/>
                                <point p="l"/>
                                <point p="u"/>
                                <point p="d"/>
                                <label anchor="(0,0.)" alignment="ne">Circumference = 12</label>

                            </coordinates>
                        </diagram>
                    </prefigure>
  </image>


